<Window x:Class="StayActive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayActive - Configuración" Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    
    <StackPanel Margin="20">

        <TextBlock Text="Estado:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock x:Name="StatusText" Text="Inactivo" Margin="0,0,0,15"/>

        
        <Separator Margin="0,0,0,15"/>

        
        <TextBlock Text="Intervalo (segundos):" Margin="0,0,0,5"/>
        <Slider x:Name="IntervalSlider" Minimum="5" Maximum="120" Value="30"
                TickFrequency="5" IsSnapToTickEnabled="True"
                ValueChanged="IntervalSlider_ValueChanged" Margin="0,0,0,5"/>
        <TextBlock x:Name="IntervalValueText" Text="30 segundos" Margin="0,0,0,15"/>

        
        <Separator Margin="0,0,0,15"/>
        
        
        <TextBlock Text="Tipo de actividad:" Margin="0,0,0,5"/>
        <ComboBox x:Name="ActivityTypeCombo" SelectionChanged="ActivityTypeCombo_SelectionChanged" Margin="0,0,0,15">
            <ComboBoxItem Content="Mover mouse" Tag="MoveMouse" IsSelected="True"/>
            <ComboBoxItem Content="Click al aire" Tag="ClickMouse"/>
            <ComboBoxItem Content="Presionar tecla" Tag="PressKey"/>
        </ComboBox>

        
        <Separator Margin="0,0,0,15"/>

        
        <CheckBox x:Name="StartupCheckBox"
          Content="Iniciar automáticamente con Windows"
          Checked="StartupCheckBox_Changed"
          Unchecked="StartupCheckBox_Changed"
          Margin="0,0,0,15"/>

        <CheckBox x:Name="ScheduleCheckBox"
          Content="Horario automático"
          Checked="ScheduleCheckBox_Changed"
          Unchecked="ScheduleCheckBox_Changed"
          Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Desde:"/>
                <TextBox x:Name="StartTimeBox" Text="09:00" LostFocus="ScheduleTime_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Hasta:"/>
                <TextBox x:Name="EndTimeBox" Text="18:00" LostFocus="ScheduleTime_Changed"/>
            </StackPanel>
        </Grid>

        <Button Content="Activar / Desactivar" Height="35" Click="ToggleButton_Click"/>

    </StackPanel>
</Window>