<Window x:Class="StayActive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayActive - Configuración"
        Icon="/Resources/icon_menu.ico"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">

        <!-- Estado -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Inactivo" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <Separator Margin="0,0,0,15"/>

        <!-- Intervalo -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Intervalo (segundos):" VerticalAlignment="Center"/>
        </StackPanel>
        <Slider x:Name="IntervalSlider" Minimum="5" Maximum="120" Value="30"
                TickFrequency="5" IsSnapToTickEnabled="True"
                ValueChanged="IntervalSlider_ValueChanged" Margin="0,0,0,5"/>
        <TextBlock x:Name="IntervalValueText" Text="30 segundos" Margin="0,0,0,15"/>

        <!-- Tipo de actividad -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Tipo de actividad:" VerticalAlignment="Center"/>
        </StackPanel>
        <ComboBox x:Name="ActivityTypeCombo" SelectionChanged="ActivityTypeCombo_SelectionChanged" Margin="0,0,0,15">
            <ComboBoxItem Content="Mover mouse" Tag="MoveMouse" IsSelected="True"/>
            <ComboBoxItem Content="Click al aire" Tag="ClickMouse"/>
            <ComboBoxItem Content="Presionar tecla" Tag="PressKey"/>
        </ComboBox>

        <Separator Margin="0,0,0,15"/>

        <!-- Inicio automático -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="StartupCheckBox" Content="Iniciar automáticamente con Windows"
                      Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Horario automático -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="ScheduleCheckBox" Content="Horario automático"
                      Checked="ScheduleCheckBox_Changed" Unchecked="ScheduleCheckBox_Changed"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Desde:"/>
                <TextBox x:Name="StartTimeBox" Text="09:00" LostFocus="ScheduleTime_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Hasta:"/>
                <TextBox x:Name="EndTimeBox" Text="18:00" LostFocus="ScheduleTime_Changed"/>
            </StackPanel>
        </Grid>

        <!-- Toggle -->
        <Button x:Name="ToggleActionButton" Content="Activar" Height="35" Click="ToggleButton_Click"/>
        
    </StackPanel>
</Window>